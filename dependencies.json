{
  "$schema": "./schemas/dependencies.schema.json",
  "dependencies": [
    {
      "id": "pdfjs",
      "package": "pdfjs-dist",
      "version": "6.3.289",
      "license": "Apache-2.0",
      "homepage": "https://mozilla.github.io/pdf.js/",
      "assets": [
        {
          "key": "core",
          "path": "legacy/build/pdf.min.mjs",
          "mime": "text/javascript",
          "stripSourceMapComment": true,
          "compression": "auto"
        },
        {
          "key": "worker",
          "path": "legacy/build/pdf.worker.min.mjs",
          "mime": "text/javascript",
          "stripSourceMapComment": true,
          "compression": "auto"
        },
        {
          "key": "jbig2",
          "path": "wasm/jbig2.wasm",
          "mime": "application/wasm",
          "compression": "auto"
        },
        {
          "key": "openjpeg",
          "path": "wasm/openjpeg.wasm",
          "mime": "application/wasm",
          "compression": "auto"
        },
        {
          "key": "qcms",
          "path": "wasm/qcms_bg.wasm",
          "mime": "application/wasm",
          "compression": "auto"
        }
      ],
      "updates": {
        "enabled": true,
        "policy": "manual"
      }
    }
  ]
}
